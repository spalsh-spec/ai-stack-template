{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "__HOME__/Documents",
        "__HOME__/Desktop",
        "__HOME__/Downloads",
        "__HOME__/Projects"
      ]
    },
    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander@latest"],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "__GITHUB_TOKEN__"
      }
    },
    "ollama": {
      "command": "npx",
      "args": ["-y", "ollama-mcp-server"],
      "env": {
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_MODEL": "gemma3:4b"
      }
    },
    "higgsfield": {
      "command": "npx",
      "args": ["-y", "@higgsfield-ai/higgsfield-mcp"],
      "env": {
        "HIGGSFIELD_API_KEY": "__HIGGSFIELD_API_KEY__"
      }
    }
  }
}
