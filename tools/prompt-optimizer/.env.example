# Required: Anthropic API key for Claude (used by linkedin-pipeline.js and optimize.sh)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Required: OpenAI API key for GPT-4o (used by linkedin-pipeline.js strategy step)
OPENAI_API_KEY=sk-xxxxx

# Optional: Path to your Obsidian vault (defaults to ~/Obsidian/Vault)
OBSIDIAN_VAULT=/path/to/your/obsidian/vault
